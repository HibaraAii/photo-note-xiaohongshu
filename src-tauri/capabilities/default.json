{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions for files, camera, dialogs, SQLite, and HTTP.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "fs:default",
    "dialog:default",
    "camera-kessdev:allow-check-permissions",
    "camera-kessdev:allow-request-permissions",
    "camera-kessdev:allow-start-preview",
    "camera-kessdev:allow-stop-preview",
    "camera-kessdev:allow-capture",
    "camera-kessdev:allow-native-desktop-available",
    "sql:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": ["http://127.0.0.1:15721/*"]
    }
  ]
}
